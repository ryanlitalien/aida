# Every environment variable aida reads, with obviously-fake values.
# `aida init` copies this file to ~/.aida/env.example (never as a live
# .env) -- fill in real values yourself and save them to ~/.aida/.env,
# which is loaded automatically (see internal/config/config.go's
# LoadDotEnv). `aida init`'s closing diagnostic tells you which of these
# are already set and what each gap costs you.

# --- Required for the engine (LLM calls: parse/classify/plan/execute/synthesize) ---
# Anthropic API key. Without it the engine falls back to Ollama offline mode
# if configured, or fails outright.
ANTHROPIC_API_KEY=sk-ant-EXAMPLE-not-a-real-key

# --- Required for brain semantic recall (embeddings) ---
# Voyage AI key for embedding lessons/entities/tasks into brain.db. Without
# it the brain still works for keyword/FTS search and recency-based recall,
# just not semantic similarity search.
VOYAGE_API_KEY=pa-EXAMPLE-not-a-real-key

# --- Optional: voice layer (Jarvis/Aida `aida serve`, macOS only) ---
# ElevenLabs TTS, an alternative to the bundled MIT-licensed Piper voice.
# Leave unset to use Piper (en_GB-jarvis-high.onnx) instead.
ELEVENLABS_API_KEY=el-EXAMPLE-not-a-real-key
ELEVENLABS_VOICE_ID=EXAMPLE00000000000000000

# --- Optional: fallback / alternate model providers ---
# Only needed if you configure model.fallback or the models roster
# (~/.aida/models.yaml) to point at these providers.
GEMINI_API_KEY=EXAMPLE-not-a-real-key
GOOGLE_API_KEY=EXAMPLE-not-a-real-key
OPENAI_API_KEY=sk-EXAMPLE-not-a-real-key

# --- Optional: web search capability ---
BRAVE_API_KEY=BSA-EXAMPLE-not-a-real-key

# --- Optional: LiteLLM proxy usage probing (Models panel / `aida models`) ---
# Only needed if you run a LiteLLM proxy and configure the "litellm" probe
# kind in ~/.aida/models.yaml.
LITELLM_MASTER_KEY=sk-EXAMPLE-not-a-real-key
